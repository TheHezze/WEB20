<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 440" width="100%" height="100%">
  <defs>
    <style>
      

      .title-text {
        font-family: 'MedievalSharp', 'Luminari', 'Uncial Antiqua', 'Cinzel Decorative', Georgia, serif;
        font-size: 102px;
        font-weight: 700;
        fill: url(#core-gradient);
        stroke: #fffdf2;
        stroke-width: 1px;
        letter-spacing: 0.5px;
      }

      .icon-bulb {
        fill: url(#bulb-3d);
      }

      .w-circuit-trace {
        fill: none;
        stroke: #fff9db;
        stroke-width: 2.2px;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: 0.75;
      }

      .pixel-bulb-glow-base {
        fill: none;
        stroke: #fff6cc;
        stroke-width: 2.8px;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 0.01 3.99;
      }

      .pixel-bulb-casing {
        fill: none;
        stroke: #d99b00;
        stroke-width: 3.1px;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 0.01 3.99;
      }

      .pixel-bulb-core {
        fill: none;
        stroke: #ffffff;
        stroke-width: 2.25px;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 0.01 3.99;
      }

      @keyframes warm-breathe {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.94; }
      }

      .glow-layer {
        animation: warm-breathe 4s infinite ease-in-out;
      }
    </style>

    <!-- 3D Radial Gradient for Individual LED Bulbs -->
    <radialGradient id="bulb-3d" cx="38%" cy="38%" r="62%" fx="28%" fy="28%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="65%" stop-color="#fffdf2" />
      <stop offset="88%" stop-color="#ffebb3" />
      <stop offset="100%" stop-color="#f3c623" />
    </radialGradient>

    <!-- Vertical Shimmer for Main Title -->
    <linearGradient id="core-gradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="70%" stop-color="#fffef7" />
      <stop offset="100%" stop-color="#fff4cc" />
    </linearGradient>

    <!-- Reusable Bulb Elements -->
    <circle id="b" r="5.35" class="icon-bulb" />
    <circle id="wb" r="3.9" class="icon-bulb" />
    <circle id="wb-sm" r="2.6" class="icon-bulb" />

    <!-- Multi-Stage Golden Neon & Incandescent Glow -->
    <filter id="master-gold-glow" x="-35%" y="-35%" width="170%" height="170%">
      <feMorphology operator="dilate" radius="1.8" in="SourceAlpha" result="d1" />
      <feGaussianBlur stdDeviation="1.5" in="d1" result="b1" />
      <feFlood flood-color="#e5b822" flood-opacity="1" result="c1" />
      <feComposite in="c1" in2="b1" operator="in" result="glow1" />

      <feMorphology operator="dilate" radius="4.5" in="SourceAlpha" result="d2" />
      <feGaussianBlur stdDeviation="5.5" in="d2" result="b2" />
      <feFlood flood-color="#d4a017" flood-opacity="0.88" result="c2" />
      <feComposite in="c2" in2="b2" operator="in" result="glow2" />

      <feMorphology operator="dilate" radius="7" in="SourceAlpha" result="d3" />
      <feGaussianBlur stdDeviation="13" in="d3" result="b3" />
      <feFlood flood-color="#f5c73d" flood-opacity="0.55" result="c3" />
      <feComposite in="c3" in2="b3" operator="in" result="glow3" />

      <feGaussianBlur stdDeviation="24" in="SourceAlpha" result="b4" />
      <feFlood flood-color="#ffdb58" flood-opacity="0.3" result="c4" />
      <feComposite in="c4" in2="b4" operator="in" result="glow4" />

      <feMerge>
        <feMergeNode in="glow4" />
        <feMergeNode in="glow3" />
        <feMergeNode in="glow2" />
        <feMergeNode in="glow1" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <!-- High-Legibility Glow Filter for Bottom Matrix Bulb Text -->
    <filter id="legible-matrix-glow" x="-25%" y="-50%" width="150%" height="200%">
      <feMorphology operator="dilate" radius="0.9" in="SourceAlpha" result="md1" />
      <feGaussianBlur stdDeviation="0.9" in="md1" result="mb1" />
      <feFlood flood-color="#ebb418" flood-opacity="0.95" result="mc1" />
      <feComposite in="mc1" in2="mb1" operator="in" result="mg1" />

      <feMorphology operator="dilate" radius="2.0" in="SourceAlpha" result="md2" />
      <feGaussianBlur stdDeviation="2.8" in="md2" result="mb2" />
      <feFlood flood-color="#d49b15" flood-opacity="0.85" result="mc2" />
      <feComposite in="mc2" in2="mb2" operator="in" result="mg2" />

      <feGaussianBlur stdDeviation="6.5" in="SourceAlpha" result="mb3" />
      <feFlood flood-color="#f3c623" flood-opacity="0.55" result="mc3" />
      <feComposite in="mc3" in2="mb3" operator="in" result="mg3" />

      <feMerge>
        <feMergeNode in="mg3" />
        <feMergeNode in="mg2" />
        <feMergeNode in="mg1" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <!-- 5x8 PIXEL-BULB CHARACTER DEFINITIONS (Width = 521px, Midpoint = 260.5px) -->
    <g id="matrix-tagline-paths">
      <path d="M0,0 V28 M0,0 H10 M14,4 V24 M0,28 H10" />
      <path d="M20.5,0 H30.5 M25.5,0 V28 M20.5,28 H30.5" />
      <path d="M51,4 V0 H37 V28 H51 V14 H43" />
      <path d="M57.5,0 H67.5 M62.5,0 V28 M57.5,28 H67.5" />
      <path d="M74,0 H88 M81,0 V28" />
      <path d="M94.5,28 V4 L101.5,0 L108.5,4 V28 M94.5,14 H108.5" />
      <path d="M115,0 V28 H129" />

      <path d="M149,0 V28 M149,0 H159 M149,14 H159 M149,28 H159 M163,4 V10 M163,18 V24" />
      <path d="M169.5,0 V24 L173.5,28 H179.5 L183.5,24 V0" />
      <path d="M204,0 H190 V14 H204 V28 H190" />
      <path d="M210.5,0 H220.5 M215.5,0 V28 M210.5,28 H220.5" />
      <path d="M227,28 V0 M241,28 V0 M230.5,6 L234,14 L237.5,22" />
      <path d="M261.5,0 H247.5 V28 H261.5 M247.5,14 H258.5" />
      <path d="M282,0 H268 V14 H282 V28 H268" />
      <path d="M302.5,0 H288.5 V14 H302.5 V28 H288.5" />

      <path d="M322.5,0 H336.5 M329.5,0 V28" />
      <path d="M357,0 H343 V28 H357 M343,14 H354" />
      <path d="M377.5,4 V0 H363.5 V28 H377.5 V24" />
      <path d="M384,0 V28 M398,0 V28 M384,14 H398" />
      <path d="M404.5,28 V0 M418.5,28 V0 M408,6 L411.5,14 L415,22" />
      <path d="M425,0 H439 V28 H425 Z" />
      <path d="M445.5,0 V28 H459.5" />
      <path d="M466,0 H480 V28 H466 Z" />
      <path d="M500.5,4 V0 H486.5 V28 H500.5 V14 H492.5" />
      <path d="M507,0 V10 L514,14 L521,10 V0 M514,14 V28" />

      <!-- Corner & Endpoint Anchor Bulbs -->
      <path d="M0,0 h0.01 M0,14 h0.01 M0,28 h0.01 M20.5,0 h0.01 M30.5,0 h0.01 M20.5,28 h0.01 M30.5,28 h0.01 M37,0 h0.01 M37,28 h0.01 M51,28 h0.01 M51,14 h0.01 M57.5,0 h0.01 M67.5,0 h0.01 M57.5,28 h0.01 M67.5,28 h0.01 M74,0 h0.01 M88,0 h0.01 M81,28 h0.01 M94.5,28 h0.01 M108.5,28 h0.01 M115,0 h0.01 M115,28 h0.01 M129,28 h0.01 M149,0 h0.01 M149,14 h0.01 M149,28 h0.01 M169.5,0 h0.01 M183.5,0 h0.01 M190,0 h0.01 M204,0 h0.01 M190,14 h0.01 M204,14 h0.01 M204,28 h0.01 M190,28 h0.01 M210.5,0 h0.01 M220.5,0 h0.01 M210.5,28 h0.01 M220.5,28 h0.01 M227,0 h0.01 M227,28 h0.01 M241,0 h0.01 M241,28 h0.01 M247.5,0 h0.01 M261.5,0 h0.01 M247.5,14 h0.01 M247.5,28 h0.01 M261.5,28 h0.01 M268,0 h0.01 M282,0 h0.01 M268,14 h0.01 M282,14 h0.01 M282,28 h0.01 M268,28 h0.01 M288.5,0 h0.01 M302.5,0 h0.01 M288.5,14 h0.01 M302.5,14 h0.01 M302.5,28 h0.01 M288.5,28 h0.01 M322.5,0 h0.01 M336.5,0 h0.01 M329.5,28 h0.01 M343,0 h0.01 M357,0 h0.01 M343,14 h0.01 M343,28 h0.01 M357,28 h0.01 M363.5,0 h0.01 M363.5,28 h0.01 M384,0 h0.01 M384,28 h0.01 M398,0 h0.01 M398,28 h0.01 M404.5,0 h0.01 M404.5,28 h0.01 M418.5,0 h0.01 M418.5,28 h0.01 M425,0 h0.01 M439,0 h0.01 M439,28 h0.01 M425,28 h0.01 M445.5,0 h0.01 M445.5,28 h0.01 M459.5,28 h0.01 M466,0 h0.01 M480,0 h0.01 M480,28 h0.01 M466,28 h0.01 M486.5,0 h0.01 M486.5,28 h0.01 M500.5,28 h0.01 M500.5,14 h0.01 M507,0 h0.01 M521,0 h0.01 M514,28 h0.01" />
    </g>
  </defs>

  <!-- ================================================================= -->
  <!-- 1. TOP "</>" DOT-MATRIX ICON & "Websiteville" MAIN BRAND TITLE    -->
  <!-- ================================================================= -->
  <g filter="url(#master-gold-glow)" class="glow-layer">
    
    <!-- "</>" LED Bulb Matrix: Local center = 300 + translate(20, 4) -> Exact X = 320.0 -->
    <g transform="translate(20, 4)">
      <!-- '<' Left Bracket -->
      <use href="#b" x="240" y="24" />
      <use href="#b" x="228" y="36" /><use href="#b" x="240" y="36" />
      <use href="#b" x="216" y="48" /><use href="#b" x="228" y="48" /><use href="#b" x="240" y="48" />
      <use href="#b" x="204" y="60" /><use href="#b" x="216" y="60" /><use href="#b" x="228" y="60" />
      <use href="#b" x="192" y="72" /><use href="#b" x="204" y="72" /><use href="#b" x="216" y="72" />
      <use href="#b" x="180" y="84" /><use href="#b" x="192" y="84" /><use href="#b" x="204" y="84" />
      <use href="#b" x="168" y="96" /><use href="#b" x="180" y="96" /><use href="#b" x="192" y="96" />
      <use href="#b" x="168" y="108" /><use href="#b" x="180" y="108" /><use href="#b" x="192" y="108" />
      <use href="#b" x="180" y="120" /><use href="#b" x="192" y="120" /><use href="#b" x="204" y="120" />
      <use href="#b" x="192" y="132" /><use href="#b" x="204" y="132" /><use href="#b" x="216" y="132" />
      <use href="#b" x="204" y="144" /><use href="#b" x="216" y="144" /><use href="#b" x="228" y="144" />
      <use href="#b" x="216" y="156" /><use href="#b" x="228" y="156" /><use href="#b" x="240" y="156" />
      <use href="#b" x="228" y="168" /><use href="#b" x="240" y="168" />
      <use href="#b" x="240" y="180" />

      <!-- '/' Forward Slash -->
      <use href="#b" x="336" y="24" />
      <use href="#b" x="324" y="36" /><use href="#b" x="336" y="36" />
      <use href="#b" x="324" y="48" /><use href="#b" x="336" y="48" />
      <use href="#b" x="312" y="60" /><use href="#b" x="324" y="60" />
      <use href="#b" x="312" y="72" /><use href="#b" x="324" y="72" />
      <use href="#b" x="300" y="84" /><use href="#b" x="312" y="84" />
      <use href="#b" x="300" y="96" /><use href="#b" x="312" y="96" />
      <use href="#b" x="288" y="108" /><use href="#b" x="300" y="108" />
      <use href="#b" x="288" y="120" /><use href="#b" x="300" y="120" />
      <use href="#b" x="276" y="132" /><use href="#b" x="288" y="132" />
      <use href="#b" x="276" y="144" /><use href="#b" x="288" y="144" />
      <use href="#b" x="264" y="156" /><use href="#b" x="276" y="156" />
      <use href="#b" x="264" y="168" /><use href="#b" x="276" y="168" />
      <use href="#b" x="264" y="180" />

      <!-- '>' Right Bracket -->
      <use href="#b" x="360" y="24" />
      <use href="#b" x="360" y="36" /><use href="#b" x="372" y="36" />
      <use href="#b" x="360" y="48" /><use href="#b" x="372" y="48" /><use href="#b" x="384" y="48" />
      <use href="#b" x="372" y="60" /><use href="#b" x="384" y="60" /><use href="#b" x="396" y="60" />
      <use href="#b" x="384" y="72" /><use href="#b" x="396" y="72" /><use href="#b" x="408" y="72" />
      <use href="#b" x="396" y="84" /><use href="#b" x="408" y="84" /><use href="#b" x="420" y="84" />
      <use href="#b" x="408" y="96" /><use href="#b" x="420" y="96" /><use href="#b" x="432" y="96" />
      <use href="#b" x="408" y="108" /><use href="#b" x="420" y="108" /><use href="#b" x="432" y="108" />
      <use href="#b" x="396" y="120" /><use href="#b" x="408" y="120" /><use href="#b" x="420" y="120" />
      <use href="#b" x="384" y="132" /><use href="#b" x="396" y="132" /><use href="#b" x="408" y="132" />
      <use href="#b" x="372" y="144" /><use href="#b" x="384" y="144" /><use href="#b" x="396" y="144" />
      <use href="#b" x="360" y="156" /><use href="#b" x="372" y="156" /><use href="#b" x="384" y="156" />
      <use href="#b" x="360" y="168" /><use href="#b" x="372" y="168" />
      <use href="#b" x="360" y="180" />
    </g>

    <!-- =============================================================== -->
    <!-- SHIFTED LEFT FOR TRUE OPTICAL & VERTICAL ALIGNMENT (X = 320)    -->
    <!-- Moved entire Websiteville wordmark 28px left so the visual      -->
    <!-- center ("sit") sits directly below "/" and above "BUSINESS"     -->
    <!-- =============================================================== -->
    <g id="centered-brand-wordmark" transform="translate(-28, 0)">
      <!-- Custom Digital-Gothic "W" -->
      <g id="custom-digital-w" transform="translate(37, 222)">
        <path class="w-circuit-trace" d="
          M 10,8 L 24,8 L 41,80
          M 18,32 L 32,32
          M 26,56 L 40,56
          M 50,12 L 62,12 L 48,68
          M 41,80 L 62,34 L 82,80
          M 96,12 L 106,8
        " />

        <path fill="url(#core-gradient)" stroke="#fffdf2" stroke-width="1" d="
          M 47,8
          L 65,0
          L 60,12
          L 78,74
          L 94,16
          L 86,10
          L 106,0
          L 116,12
          L 105,18
          L 83,98
          L 71,94
          L 59,50
          L 43,98
          L 32,94
          L 51,32
          L 42,16
          Z
        " />

        <use href="#wb" x="2" y="16" />
        <use href="#wb" x="10" y="8" />
        <use href="#wb" x="18" y="0" />

        <use href="#wb" x="16" y="16" /><use href="#wb" x="25" y="16" />
        <use href="#wb" x="19" y="25" /><use href="#wb" x="28" y="25" />
        <use href="#wb" x="22" y="34" /><use href="#wb" x="31" y="34" />
        <use href="#wb" x="25" y="43" /><use href="#wb" x="34" y="43" />
        <use href="#wb" x="28" y="52" /><use href="#wb" x="37" y="52" />
        <use href="#wb" x="31" y="61" /><use href="#wb" x="40" y="61" />
        <use href="#wb" x="34" y="70" /><use href="#wb" x="43" y="70" />
        <use href="#wb" x="37" y="79" />

        <use href="#wb-sm" x="6" y="29" />
        <use href="#wb-sm" x="12" y="46" />
        <use href="#wb-sm" x="19" y="65" />
        <use href="#wb-sm" x="62" y="24" />
        <use href="#wb-sm" x="90" y="3" />
      </g>

      <!-- Natural font kerning (removed forced textLength stretch that pushed the right side out) -->
      <text x="145" y="318" text-anchor="start" class="title-text">ebsiteville</text>
    </g>
  </g>

  <!-- ================================================================= -->
  <!-- 2. "DIGITAL BUSINESS TECHNOLOGY" (Midpoint = 260.5 + 59.5 = 320)  -->
  <!-- ================================================================= -->
  <g transform="translate(59.5, 370)">
    <use href="#matrix-tagline-paths" class="pixel-bulb-glow-base" filter="url(#legible-matrix-glow)" />
    <use href="#matrix-tagline-paths" class="pixel-bulb-casing" opacity="0.85" />
    <use href="#matrix-tagline-paths" class="pixel-bulb-core" />
  </g>
</svg>